{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appt",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "4f6425a7-5aa5-479f-afef-a493cd893bed","database_name": "web-appt" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "90040cb4a8b94f54a9e1471832d8a2e9" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
